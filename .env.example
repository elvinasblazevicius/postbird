# Copy to .env.local for local development. On Netlify (or Vercel), add the same
# names under the project's Environment variables. Never commit real values.

# ── Required ──────────────────────────────────────────────────
# Supabase → Project → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Long random text (32+ characters). Signs admin logins and protects the /api/cron addresses.
CRON_SECRET=

# Admin password for /admin (10+ characters).
ADMIN_PASSWORD=

# Your Inoreader output feed addresses, one per line or comma-separated.
# Optional "Name | URL" form gives each feed a readable name. You can also add feeds in /admin/feeds.
INOREADER_FEED_URLS=

# ── Optional ──────────────────────────────────────────────────
# Public address, e.g. https://your-site.netlify.app (set this on Netlify).
NEXT_PUBLIC_SITE_URL=

# Email (Resend). Sign-ups are stored without it; emails start once it's set and your domain is verified.
RESEND_API_KEY=
# Sender, must use your verified domain. Defaults to emailFrom in site.config.ts.
EMAIL_FROM=

# Microsoft Advertising (Bing Ads) UET tag ID — turns on conversion tracking.
NEXT_PUBLIC_MS_UET_TAG_ID=

# ── Paid email alerts: Paddle Billing (README section 6) ─────
# Leave the three NEXT_PUBLIC_PADDLE_* values below empty to keep the early-access
# sign-up (nothing charged). All three set = real checkout. Redeploy after changing them.
# sandbox (testing, the default) or production.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle → My account → Settings → Authentication → Client-side tokens (test_… or live_…). Public by design.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price IDs (pri_…) of the two prices on the alerts product, each with a 14-day trial that requires a card:
# $9.99 every 1 month, and $19.99 every 3 months. Keep them equal to the prices in site.config.ts.
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_QUARTERLY=
# Server-only secrets. API key permissions: "Customer portal session: write" and "Subscription: read".
PADDLE_API_KEY=
# Secret key of the notification destination https://postbird.nuevanova.com/api/paddle/webhook (pdl_ntfset_…).
PADDLE_WEBHOOK_SECRET=

# Separate secrets if you prefer (default to CRON_SECRET).
ADMIN_SESSION_SECRET=
ANALYTICS_SALT=
