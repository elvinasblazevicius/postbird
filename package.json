{
  "name": "postbird",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-flags.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-flags.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "sync": "tsx --env-file-if-exists=.env.local scripts/sync.ts",
    "demo:seed": "tsx --env-file-if-exists=.env.local scripts/demo.ts seed",
    "demo:clear": "tsx --env-file-if-exists=.env.local scripts/demo.ts clear",
    "digest": "tsx --env-file-if-exists=.env.local scripts/digest.ts",
    "build:map": "node scripts/build-world-dots.mjs",
    "diagnose": "tsx --env-file-if-exists=.env.local scripts/diagnose.ts",
    "sources": "tsx --env-file-if-exists=.env.local scripts/sources.ts",
    "tidy-jobs": "tsx --env-file-if-exists=.env.local scripts/tidy-jobs.ts",
    "tidy-jobs-dry-run": "tsx --env-file-if-exists=.env.local scripts/tidy-jobs.ts --dry-run",
    "reclassify": "tsx --env-file-if-exists=.env.local scripts/reclassify.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "flag-icons": "^7.6.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
